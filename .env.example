APP_ENV=development
APP_URL=http://localhost:8080
APP_KEY=change-this-to-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Para producción usa la misma base MySQL operativa actual.
# SQLite sigue disponible únicamente para desarrollo de la interfaz.
DB_DRIVER=sqlite
DB_DATABASE=storage/form-studio.sqlite
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u350704768_M4FvI
# DB_USERNAME=
# DB_PASSWORD=

# Puente temporal mientras las tablas CCT cambian gradualmente de nombre.
LEGACY_TABLE_PREFIX=wp_
INVENTORY_SCHEMA_PATH=
INVENTORY_ACTIONS_PATH=

# Acciones posteriores al guardado. Se mantienen apagadas hasta validar staging.
INVENTORY_EXTERNAL_ACTIONS=false
INVENTORY_WEBHOOK_URL=
INVENTORY_REPORT_RECIPIENTS=
NOTIFICATION_EMAIL_PROVIDER=smtp

# Ayuda opcional para convertir dictado en campos estructurados.
MINIMAX_ENDPOINT=
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.1

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@skc.local
ADMIN_PASSWORD=ChangeMe123!
TOKEN_TTL_HOURS=12
ALLOW_PRIVATE_WEBHOOKS=false
